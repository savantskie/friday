fridayonline.bounceme.net {
    tls "/media/nate/Friday/Friday/certs/friday.pem" "/media/nate/Friday/Friday/certs/friday.key"
	
	# Security headers, and securing mcpo (add-only)
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    # Route ordering: specific paths first, then default OWUI
    route {
        # ---------- MCPo (tools) over same-origin HTTPS ----------
        @preflight_mcp {
            method OPTIONS
            path /mcpo*
        }
        header @preflight_mcp {
            Access-Control-Allow-Origin "https://fridayonline.bounceme.net"
            Access-Control-Allow-Methods "GET,POST,PUT,PATCH,DELETE,OPTIONS"
            Access-Control-Allow-Headers "*"
            Access-Control-Allow-Credentials "true"
        }
        respond @preflight_mcp 204

        @mcp path /mcpo*
        header @mcp {
            Access-Control-Allow-Origin "https://fridayonline.bounceme.net"
            Access-Control-Allow-Credentials "true"
        }

        handle_path /mcpo* {
            reverse_proxy 192.168.1.50:12345
        }

        # ---------- OAuth Proxy (for Claude Desktop integration) ----------
        @preflight_oauth {
            method OPTIONS
            path /oauth*
        }
        header @preflight_oauth {
            Access-Control-Allow-Origin "https://fridayonline.bounceme.net"
            Access-Control-Allow-Methods "GET,POST,PUT,PATCH,DELETE,OPTIONS"
            Access-Control-Allow-Headers "*"
            Access-Control-Allow-Credentials "true"
        }
        respond @preflight_oauth 204

        @oauth path /oauth*
        header @oauth {
            Access-Control-Allow-Origin "https://fridayonline.bounceme.net"
            Access-Control-Allow-Credentials "true"
        }
        handle /oauth* {
            reverse_proxy localhost:8888
        }

        # ---------- MCP Proxy Endpoint (Claude Desktop with OAuth) ----------
        @preflight_mcp_oauth {
            method OPTIONS
            path /mcp*
        }
        header @preflight_mcp_oauth {
            Access-Control-Allow-Origin "https://fridayonline.bounceme.net"
            Access-Control-Allow-Methods "GET,POST,PUT,PATCH,DELETE,OPTIONS"
            Access-Control-Allow-Headers "*"
            Access-Control-Allow-Credentials "true"
        }
        respond @preflight_mcp_oauth 204

        @mcp_oauth path /mcp*
        header @mcp_oauth {
            Access-Control-Allow-Origin "https://fridayonline.bounceme.net"
            Access-Control-Allow-Credentials "true"
        }
        handle_path /mcp* {
            reverse_proxy localhost:8888
        }

        # ---------- LM Studio via same-origin HTTPS ----------
        @preflight_lms {
            method OPTIONS
            path /lmstudio*
        }
        header @preflight_lms {
            Access-Control-Allow-Origin "https://fridayonline.bounceme.net"
            Access-Control-Allow-Methods "GET,POST,PUT,PATCH,DELETE,OPTIONS"
            Access-Control-Allow-Headers "*"
            Access-Control-Allow-Credentials "true"
        }
        respond @preflight_lms 204

        @lms path /lmstudio*
        header @lms {
            Access-Control-Allow-Origin "https://fridayonline.bounceme.net"
            Access-Control-Allow-Credentials "true"
        }
        handle_path /lmstudio* {
            reverse_proxy 192.168.1.50:1234
        }

        handle_path /mcp-anythingllm* {
            uri strip_prefix /mcp-anythingllm
            reverse_proxy 192.168.1.50:12345
        }

        # --- OWUI STATIC ASSETS MUST BE HERE ---
        @static_app path /_app/*
        handle @static_app {
            reverse_proxy 127.0.0.1:3000
        }

        @static_assets path /assets/*
        handle @static_assets {
            reverse_proxy 127.0.0.1:3000
        }

        @static_build path /build/*
        handle @static_build {
            reverse_proxy 127.0.0.1:3000
        }

        # ---------- OpenID Configuration (no auth required) ----------
        # Route .well-known endpoints to OAuth proxy for OpenID discovery
        @well_known path /.well-known/*
        handle @well_known {
            reverse_proxy localhost:8888
        }

        # ---------- Claude.ai MCP (JWT token-based routing) ----------
        # Route requests with JWT bearer tokens (start with eyJ) to OAuth proxy
        @claude_mcp {
            header Authorization "Bearer eyJ*"
        }
        handle @claude_mcp {
            reverse_proxy localhost:8888
        }

        # ---------- Default: proxy OpenWebUI ----------
        # Handles browser requests (no auth) and OpenWebUI MCPO requests (specific bearer token)
        reverse_proxy 127.0.0.1:3000 {
            transport http {
                versions 1.1
            }
        }
    }
