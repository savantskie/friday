fridayonline.bounceme.net {
    tls "F:\Friday\certs\friday.pem" "F:\Friday\certs\friday.key"
	
	# Security headers, and securing mcpo (add-only)
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    @bad_api_key {
        path /mcpo*
        not header X-API-Key "{env.MCPO_API_KEY}"
    }
    
    respond @bad_api_key 403 {
        body "[🔥 BLOCKED] Unauthorized access attempt to /mcpo — missing or wrong API key."
    }


    # Route ordering: specific paths first, then default OWUI
    route {
        # ---------- MCPo (tools) over same-origin HTTPS ----------
        @preflight_mcp {
            method OPTIONS
            path /mcpo*
        }
        # Preflight CORS for /mcpo
        header @preflight_mcp {
            Access-Control-Allow-Origin "https://fridayonline.bounceme.net"
            Access-Control-Allow-Methods "GET,POST,PUT,PATCH,DELETE,OPTIONS"
            Access-Control-Allow-Headers "*"
            Access-Control-Allow-Credentials "true"
        }
        respond @preflight_mcp 204

        # Actual requests to /mcpo*
        @mcp path /mcpo*
        header @mcp {
            Access-Control-Allow-Origin "https://fridayonline.bounceme.net"
            Access-Control-Allow-Credentials "true"
        }    
        # ---- static /notify test page (add-only) ----
        handle /notify* {
            root * F:\Friday\pwa
            file_server
        }
                # ---- static /pwa (serves F:\Friday\pwa) ----
        handle_path /pwa* {
            root * F:\Friday\pwa
            file_server
        }
        # Root-scope SW for OWUI (serve from disk)
        handle /owui-sw.js* {
            root * F:\Friday\pwa
            file_server
        }

        }
        handle_path /mcpo* {
            reverse_proxy 192.168.1.50:12345
        }

        # ---------- LM Studio via same-origin HTTPS ----------
        @preflight_lms {
            method OPTIONS
            path /lmstudio*
        }
        header @preflight_lms {
            Access-Control-Allow-Origin "https://fridayonline.bounceme.net"
            Access-Control-Allow-Methods "GET,POST,PUT,PATCH,DELETE,OPTIONS"
            Access-Control-Allow-Headers "*"
            Access-Control-Allow-Credentials "true"
        }
        respond @preflight_lms 204

        @lms path /lmstudio*
        header @lms {
            Access-Control-Allow-Origin "https://fridayonline.bounceme.net"
            Access-Control-Allow-Credentials "true"
        }
        handle_path /lmstudio* {
            reverse_proxy 192.168.1.50:1234
        }

        # ---------- Default: proxy OpenWebUI ----------
        reverse_proxy localhost:3000
    }


:80 {
    redir https://fridayonline.bounceme.net{uri}
}
